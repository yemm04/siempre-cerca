# Variables de entorno — Siempre Cerca
# Copia este archivo como .env y rellena los valores en Avance 2

# Avance 2: URL base del backend (Node.js + Express)
# API_BASE_URL=http://localhost:4000

# Avance 2: URI de conexión a MongoDB Atlas
# MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@cluster0.mongodb.net/siempre-cerca

# Avance 2: Puerto del servidor Express
# PORT=4000
